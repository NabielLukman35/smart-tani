# Konfigurasi Environment Aplikasi Mobile TaniGreen
# Sesuai Bagian 6 & 7 PRD (Non-Fungsional: Keamanan API Key)

# Endpoint Backend API (Gunakan 10.0.2.2 untuk Android Emulator, localhost untuk Windows/Web)
API_BASE_URL=http://10.0.2.2:3000/api

# Google Gemini AI API Key (FR-09)
GEMINI_API_KEY=

# OpenStreetMap User Agent (FR-04: Wajib User Agent pada reverse geocoding Nominatim)
NOMINATIM_USER_AGENT=TaniGreenApp/1.0 (contact@tanigreen.id)

# Kurs API Base URL (FR-06)
FRANKFURTER_API_URL=https://api.frankfurter.app/latest
